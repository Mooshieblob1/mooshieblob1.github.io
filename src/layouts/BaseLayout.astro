---
import SecurityHead from '../components/SecurityHead.astro';
import '../styles/style.css';
interface Props { title?: string; description?: string; }
const { title = 'Blob — Mooshieblob', description = 'Blob’s corner of the internet. Web projects, AI images, games, and anime.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [{ href: '/', label: 'Profile' }, { href: '/images', label: 'Images' }, { href: '/about', label: 'About' }, { href: '/submit', label: 'Submit an idea' }];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SecurityHead />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a1021" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/images/page.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/images/page.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'home-page': path === '/' }}>
    <a class="skip-to-main" href="#main-content">Skip to main content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="Blob home">
        <img src="/assets/images/bloblogo.webp" alt="Blob" width="979" height="729" />
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        {links.map(link => <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>)}
      </nav>
      <a class="header-project" href="https://mooshieui.mooshieblob.com" target="_blank" rel="noopener noreferrer">MooshieUI <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer shell">
      <a href="/" class="footer-brand"><img src="/assets/images/bloblogo.webp" alt="Blob home" width="979" height="729" /><span class="footer-note">A little corner of the internet.</span></a>
      <span class="copyright">© {new Date().getFullYear()} Mooshieblob</span>
      <a href="https://github.com/Mooshieblob1/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </footer>
  </body>
</html>

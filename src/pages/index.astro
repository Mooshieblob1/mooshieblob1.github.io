---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <div class="shell">
    <section class="profile-hero" aria-labelledby="profile-title">
      <div class="profile-copy">
        <p class="eyebrow"><span class="short-line" aria-hidden="true"></span> MOOSHIEBLOB / PERSONAL SPACE</p>
        <h1 id="profile-title"><span class="hello">Hey, I’m</span>Blob<span class="yellow">.</span></h1>
        <p class="hero-description">I build things for the web, play with AI,<br class="desktop-break" /> and get a little too invested in games and anime.</p>
        <div class="hero-actions">
          <a class="button primary" href="/images">Explore my images <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/about">A bit about me <span aria-hidden="true">→</span></a>
        </div>
        <div class="social-row" aria-label="Social links">
          <span class="mono-label">FIND ME ON</span>
          <a href="https://github.com/Mooshieblob1/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href="https://x.com/mooshieblob" target="_blank" rel="noopener noreferrer">Twitter / X ↗</a>
        </div>
      </div>
      <div class="character-stage">
        <div class="character-disc" aria-hidden="true"></div>
        <div class="character-dots" aria-hidden="true"></div>
        <span class="character-side-note" aria-hidden="true">A LITTLE RAIN NEVER HURT.</span>
        <img class="hero-character" src="/assets/images/raingirl.webp" alt="Blob’s ratgirl mascot: black hair, blue eyes, and a bright yellow raincoat." width="1248" height="1856" fetchpriority="high" />
        <span class="character-sticker" aria-hidden="true">am blob.</span>
      </div>
    </section>
    <section class="around-section" aria-labelledby="around-title">
      <div class="section-heading"><h2 id="around-title">Make yourself at home.</h2><span class="mono-label">A FEW PLACES TO WANDER</span></div>
      <div class="page-links">
        <a href="/images" class="page-link"><span class="link-number">01 /</span><h3>Images</h3><p>A selection of my AI image posts.</p><span class="link-arrow" aria-hidden="true">↗</span></a>
        <a href="/about" class="page-link"><span class="link-number">02 /</span><h3>About Blob</h3><p>The person behind the pixels.</p><span class="link-arrow" aria-hidden="true">↗</span></a>
        <a href="/submit" class="page-link"><span class="link-number">03 /</span><h3>Got an idea?</h3><p>Send an image request my way.</p><span class="link-arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="project-feature" aria-labelledby="project-title">
      <div class="project-mark" aria-hidden="true">M<span>UI</span></div>
      <div class="project-copy"><p class="eyebrow">SOMETHING I’M BUILDING</p><h2 id="project-title">MooshieUI</h2><p>A friendlier way to create with ComfyUI. From your first prompt to inpainting and upscaling, without wiring up a node graph.</p></div>
      <a class="button secondary" href="https://mooshieui.mooshieblob.com" target="_blank" rel="noopener noreferrer">Check it out <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>

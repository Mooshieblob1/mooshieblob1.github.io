---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Submit an idea — Blob" description="Have an image in mind? Send your idea to Blob.">
  <div class="shell inner-page submit-page">
    <div class="submit-grid">
      <div class="submit-intro"><p class="eyebrow">YOUR IDEA, MY NEXT EXPERIMENT</p><h1>Something<br />on your <span class="yellow">mind?</span></h1><p class="page-intro">A character, a scene, or a wonderfully specific idea.<br />Send an image request my way.</p><div class="submit-mascot"><img src="/assets/images/raingirl.webp" alt="Ratgirl mascot waiting to hear your idea" width="1248" height="1856" /><span aria-hidden="true">I’m listening.</span></div></div>
      <div class="request-panel">
        <h2>Leave an idea.</h2><p class="form-description">Tell me what you’d like to see.</p>
        <div id="submission-success" class="success-message" role="status" hidden>Thanks for sharing your idea.</div>
        <form action="https://formsubmit.co/blob@mooshieblob.com" method="POST" data-astro-reload>
          <input type="text" name="_honey" class="honeypot" aria-hidden="true" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_subject" value="New image request from mooshieblob.com" />
          <input id="form-return" type="hidden" name="_next" value="https://mooshieblob.com/submit?submitted=1" />
          <label for="idea">Your image idea</label>
          <textarea id="idea" name="message" rows="8" maxlength="5000" placeholder="I’m thinking of…" required aria-describedby="idea-hint"></textarea>
          <p id="idea-hint" class="field-hint">Characters, setting, mood — as much detail as you like.</p>
          <button type="submit" class="button primary">Send idea <span aria-hidden="true">↗</span></button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
<script>
  const returnInput = document.getElementById('form-return') as HTMLInputElement | null;
  if (returnInput) returnInput.value = new URL('/submit?submitted=1', window.location.origin).href;
  if (new URLSearchParams(window.location.search).get('submitted') === '1') {
    document.getElementById('submission-success')?.removeAttribute('hidden');
  }
</script>

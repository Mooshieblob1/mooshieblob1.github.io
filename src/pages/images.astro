---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageGallery from '../components/ImageGallery.vue';
---
<BaseLayout title="Images — Blob" description="A selection of Blob’s AI image posts. Browse the gallery and open images at full size.">
  <div class="shell inner-page gallery-page">
    <div class="page-heading gallery-heading">
      <div><p class="eyebrow">THE IMAGE COLLECTION</p><h1>A little <span class="yellow">imagination.</span></h1><p class="page-intro">A selection of my posts from <a class="source-link" href="https://aibooru.online/users/2949" target="_blank" rel="noopener noreferrer">AIbooru ↗</a>.</p></div>
      <a class="text-link" href="/submit">Got an image idea? <span aria-hidden="true">↗</span></a>
    </div>
    <ImageGallery client:load />
    <noscript><p class="noscript-notice">Enable JavaScript to load the image collection.</p></noscript>
  </div>
</BaseLayout>
